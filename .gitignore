# environment, caches, secrets
.venv/
__pycache__/
*.pyc
.openai_key
/*.log
sim/cache/

# not ours to redistribute: the task brief and third-party papers / media
Robot_Learning_Sharpa.pdf
resources/
reports/eden_simtoolreal_sharpa.mp4

# the written report is sent separately
reports/report.pdf
scripts/make_report.py

# weights and per-frame evaluation arrays live in the Hugging Face model repository (release.hf_repo in configs/default.yaml),
# at the same relative paths: `hf download <repo> --local-dir .` puts them back
runs/**/*.pt
runs/**/*.npz
reports/**/*.npz
checkpoints/
.cache/
MUJOCO_LOG.TXT

# built by scripts/build_stage3_page.py and published on the gh-pages branch (the videos are in reports/stage3/videos/)
reports/stage3/page/

# stage 3: the final actor of each run is small (1.4 MB) and stays in git with its synergy basis; intermediate checkpoints do not
!runs/stage3/*/ckpt.pt
!runs/stage3/*/synergy.npz
runs/stage3/smoke/
runs/stage3/_gate_closed/
